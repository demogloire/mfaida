# Copier ce fichier en .env et remplir les valeurs pour le développement local
# Sur Heroku, configurer ces variables via : heroku config:set NOM=VALEUR

# ── Sécurité ──────────────────────────────────────────────────────────────────
SECRET_KEY=votre-cle-secrete-ici

# Mode debug (True en dev, False en production)
DEBUG=True

# Hôtes autorisés (ex: monapp.herokuapp.com,www.mondomaine.com)
ALLOWED_HOSTS=localhost,127.0.0.1

# Origines de confiance pour CSRF (ex: https://monapp.herokuapp.com)
CSRF_TRUSTED_ORIGINS=https://monapp.herokuapp.com

# ── Base de données ───────────────────────────────────────────────────────────
# Sur Heroku : JAWSDB_URL est automatiquement défini par l'add-on JawsDB MySQL
# JAWSDB_URL=mysql://user:password@host:3306/dbname

# En local (MySQL) :
DB_NAME=m_faida
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# ── Cloudinary (stockage des fichiers uploadés) ───────────────────────────────
# Créer un compte sur https://cloudinary.com (gratuit) puis récupérer ces valeurs
# dans Dashboard > API Keys
CLOUDINARY_CLOUD_NAME=votre-cloud-name
CLOUDINARY_API_KEY=votre-api-key
CLOUDINARY_API_SECRET=votre-api-secret
