# Copier ce fichier en .env et remplir les valeurs pour le développement local
# Sur Heroku, configurer ces variables via : heroku config:set NOM=VALEUR

# Clé secrète Django (générer une nouvelle avec : python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())")
SECRET_KEY=votre-cle-secrete-ici

# Mode debug (True en dev, False en production)
DEBUG=True

# Hôtes autorisés (ex: monapp.herokuapp.com,www.mondomaine.com)
ALLOWED_HOSTS=localhost,127.0.0.1

# Base de données (renseignée automatiquement par Heroku pour PostgreSQL)
# DATABASE_URL=postgres://user:password@host:5432/dbname
